{
  "name": "healtrip-ai-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm build:shared && pnpm --filter @healtrip/api --filter @healtrip/web build",
    "build:shared": "pnpm --filter @healtrip/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter @healtrip/api --filter @healtrip/web dev",
    "dev:rag": "cd apps/rag && .venv/bin/uvicorn app.main:app --reload --port 8001",
    "lint": "eslint .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:rag": "cd apps/rag && .venv/bin/pytest -q",
    "db:migrate": "pnpm --filter @healtrip/api db:migrate",
    "db:seed": "pnpm --filter @healtrip/api db:seed",
    "rag:setup": "cd apps/rag && python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
    "rag:ingest": "cd apps/rag && .venv/bin/python -m app.ingest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
