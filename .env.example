# ---- Copy to .env for local development (never commit real secrets) ----

# Database (Prisma URL for the API; plain libpq URL for the RAG service)
DATABASE_URL=postgresql://healtrip:healtrip@localhost:5432/healtrip?schema=public
RAG_DATABASE_URL=postgresql://healtrip:healtrip@localhost:5432/healtrip

# API
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=20
EXPOSE_TRACE=true

# LLM: mock (no key needed) | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# "openai" also works with any OpenAI-compatible API. Set LLM_PROVIDER=openai plus:
#   Gemini     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-3.5-flash-lite
#   Groq       OPENAI_BASE_URL=https://api.groq.com/openai/v1                            OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1                              OPENAI_MODEL=<any model id>
#   DeepSeek   OPENAI_BASE_URL=https://api.deepseek.com/v1                               OPENAI_MODEL=deepseek-chat
#   Ollama     OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:7b  OPENAI_TOOL_CHOICE=auto  (no key)
OPENAI_BASE_URL=
OPENAI_TOOL_CHOICE=required
LLM_TEMPERATURE=0.1
AGENT_MAX_TOOL_STEPS=5
AGENT_TIMEOUT_MS=20000

# RAG service (internal only)
RAG_URL=http://localhost:8001
RAG_INTERNAL_TOKEN=dev-internal-token
RAG_TIMEOUT_MS=3000
EMBEDDINGS_PROVIDER=mock

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SHOW_TRACE=true
